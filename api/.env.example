# DATABASE_URL="sqlserver://192.168.0.128:1433;database=valeexpresso;user=teste;password=teste;encrypt=true;trustServerCertificate=true"
DATABASE_URL="sqlserver://{YOUR_DATABASE_HOST}:{YOUR_DATABASE_PORT};database={YOUR_DATABASE_NAME};user={YOUR_DATABASE_USER};password={YOUR_DATABASE_PASSWORD};encrypt=true;trustServerCertificate=true"
DATABASE_USER="{YOUR_DATABASE_USER}"
DATABASE_PASSWORD="{YOUR_DATABASE_PASSWORD}"
DATABASE_NAME="{YOUR_DATABASE_NAME}"
DATABASE_HOST="{YOUR_DATABASE_HOST}"
DATABASE_PORT=1433

JWT_EXPIRATION_TIME=720 # em minutos

# Auth / Cookies
FRONTEND_URL={YOUR_FRONTEND_URL}
JWT_SECRET={YOUR_JWT_SECRET}
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

#RM
RM_API_URL=http://wsdlrmhom.expressonepomuceno.com.br:12200/RMSRestDataServer/rest/
RM_NEW_API_URL=http://wsdlrmhom.expressonepomuceno.com.br:12202/api/framework/v1/
RM_COD_SISTEMA=G
RM_COLIGADA_GLOBAL=0
RM_METADATA_DATASERVER=RMSPRJ4791552Server

# 32 bytes (base64 ou hex) para AES-256-GCM
# Exemplo base64 (32 bytes): 8r7qV2e3p9p7c9q6x8t8qYJk8w2m3v5nQ9j1m2n3o4s=
CREDENTIALS_ENCRYPTION_KEY=8r7qV2e3p9p7c9q6x8t8qYJk8w2m3v5nQ9j1m2n3o4s=

# Google Maps API
GOOGLE_MAPS_API_URL=https://routes.googleapis.com/distanceMatrix/v2:computeRouteMatrix
GOOGLE_MAPS_API_KEY={YOUR_GOOGLE_MAPS_API_KEY}

# Dashboard / Regras (indicadores)
# Alertas de valores fora do intervalo para CODEVENTO=R066 e fórmula tipo='V'
R066_MIN_VAL=50
R066_MAX_VAL=400

TZ=America/Sao_Paulo